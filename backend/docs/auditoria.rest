# ====================================================================
# URBAN BITES - Módulo de Auditoría (Bitácora de Seguridad) y Kardex
# Documentación para REST Client de Visual Studio Code
# Solo accesible para el rol Administrador
# ====================================================================

@baseUrl = http://Urbanbites.com/backend/routes/api.php
# Reemplazar con el token obtenido al iniciar sesión como Administrador
@adminToken = TU_TOKEN_ADMIN_AQUI

### 1. Listar registros recientes de la bitácora de auditoría
# Registra actor, acción, entidad afectada, identificador, valores previos y nuevos, IP y fecha
# Respuesta esperada: 200 OK con lista de eventos ordenados descendentemente
GET {{baseUrl}}/auditoria/listar
Accept: application/json
Authorization: Bearer {{adminToken}}

### 2. Filtrar bitácora por rango de fechas
# Respuesta esperada: 200 OK con registros en el rango especificado
GET {{baseUrl}}/auditoria/listar?fecha_inicio=2026-11-01&fecha_fin=2026-11-18
Accept: application/json
Authorization: Bearer {{adminToken}}

### 3. Filtrar bitácora por acción específica
# Acciones disponibles: MODIFICAR_PRECIO, MODIFICAR_STOCK, CREAR, ACTUALIZAR, DESACTIVAR, VENTA_REGISTRADA, AJUSTE_INVENTARIO
# Respuesta esperada: 200 OK con eventos de cambio de precio
GET {{baseUrl}}/auditoria/listar?accion=MODIFICAR_PRECIO
Accept: application/json
Authorization: Bearer {{adminToken}}

### 4. Filtrar bitácora por entidad (ej. productos, usuarios, ventas)
# Respuesta esperada: 200 OK con eventos sobre productos
GET {{baseUrl}}/auditoria/listar?entidad=productos
Accept: application/json
Authorization: Bearer {{adminToken}}

### 5. Consultar historial de movimientos de inventario (Kardex)
# Registra entradas, salidas por venta y ajustes con stock anterior, nuevo, cantidad y motivo
# Respuesta esperada: 200 OK con lista de movimientos
GET {{baseUrl}}/movimientos/listar?limite=50
Accept: application/json
Authorization: Bearer {{adminToken}}
