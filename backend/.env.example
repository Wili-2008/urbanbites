; Plantilla de configuración de entorno para Urban Bites (Backend)
; Copia este archivo como 'backend/.env' y completa con tus credenciales locales o de producción.
; NUNCA subas el archivo .env con contraseñas reales al repositorio Git.

DB_HOST=localhost
DB_NAME=urban_bites
DB_USER=root
DB_PASSWORD=
DB_PORT=3306
DB_CHARSET=utf8mb4

; Clave secreta para firmar tokens JWT (mínimo 32 caracteres, preferible 64 hexadecimales)
JWT_SECRET=reemplazar_con_clave_secreta_de_al_menos_32_caracteres_aleatorios
