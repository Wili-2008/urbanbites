; Plantilla local para WAMP. Copia los valores a api/.env.
; No incluyas contrasenas reales en Git.

DB_HOST=localhost
DB_NAME=urbanbites_wamp_6
DB_USER=root
DB_PASSWORD=
DB_PORT=3306
DB_CHARSET=utf8mb4

; Clave local para firmar tokens JWT (minimo 32 caracteres)
JWT_SECRET=reemplazar_con_clave_secreta_de_al_menos_32_caracteres_aleatorios
